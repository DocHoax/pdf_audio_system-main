# ==============================================================================
# EchoDoc (PDF & Document to Audio System) - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application & Security Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=generate-a-secure-32-character-secret-key-here
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Database (PostgreSQL / SQLite)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://echodoc:echodoc_secret@localhost:5432/echodoc_db
POSTGRES_USER=echodoc
POSTGRES_PASSWORD=echodoc_secret
POSTGRES_DB=echodoc_db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Redis & Celery Message Broker
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Text-to-Speech (TTS) Providers
# Options: mock, yarngpt, azure, google, polly, elevenlabs
# ------------------------------------------------------------------------------
TTS_PROVIDER=mock

# YarnGPT (Specialized for Nigerian & African Voice Personas: Idera, Emma, Zainab, Osagie, etc.)
YARNGPT_API_KEY=your_yarngpt_api_key_here

# Microsoft Azure Speech Service
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# Google Cloud Text-to-Speech
GOOGLE_APPLICATION_CREDENTIALS=/path/to/google_credentials.json

# Amazon Web Services (Polly & S3)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# ElevenLabs Speech
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# ------------------------------------------------------------------------------
# File Storage Configuration
# Options: local, s3
# ------------------------------------------------------------------------------
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./storage
S3_BUCKET_NAME=echodoc-audio-bucket
MAX_UPLOAD_SIZE_MB=50

# ------------------------------------------------------------------------------
# Frontend Settings (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
WEB_PORT=3000
API_PORT=8000

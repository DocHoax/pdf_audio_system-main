# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pdf_audio_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pdf_audio_db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# TTS Provider Configuration
# Options: azure, google, aws_polly, elevenlabs
TTS_PROVIDER=azure
TTS_API_KEY=your-tts-api-key-here
TTS_REGION=eastus

# Azure Speech Service (if using Azure)
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastus

# Google Cloud TTS (if using Google)
GOOGLE_CLOUD_TTS_KEY=your-google-cloud-key

# AWS Polly (if using AWS)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# ElevenLabs (if using ElevenLabs)
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Storage Configuration
# Options: local, s3, r2, supabase
STORAGE_PROVIDER=local
STORAGE_PATH=./storage

# S3/R2 Configuration (if using S3 or Cloudflare R2)
STORAGE_BUCKET=pdf-audio-bucket
STORAGE_ACCESS_KEY=your-storage-access-key
STORAGE_SECRET_KEY=your-storage-secret-key
STORAGE_ENDPOINT=https://your-endpoint.r2.cloudflarestorage.com
STORAGE_REGION=auto

# Application Configuration
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=pdf
MAX_CHUNK_SIZE=5000
DEFAULT_LANGUAGE=en
DEFAULT_VOICE=en-US-AriaNeural
DEFAULT_SPEED=1.0

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
CONVERSION_LIMIT_PER_HOUR=10

# Security
BCRYPT_ROUNDS=12

# Environment
ENVIRONMENT=development
DEBUG=true

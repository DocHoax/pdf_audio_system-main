# Dockerfile for Celery Asynchronous Task Worker
FROM python:3.11-slim AS base

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    tesseract-ocr \
    tesseract-ocr-eng \
    libpq-dev \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies
COPY apps/api/requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Download NLTK data required for text chunking
RUN python -c "import nltk; nltk.download('punkt'); nltk.download('punkt_tab')"

# Copy application source code
COPY apps/api/ .

# Create directories for persistent storage
RUN mkdir -p /app/storage/uploads /app/storage/audio

ENV PYTHONUNBUFFERED=1 \
    STORAGE_TYPE=local \
    LOCAL_STORAGE_PATH=/app/storage

CMD ["celery", "-A", "app.tasks.celery_app", "worker", "--loglevel=info", "--concurrency=4"]
